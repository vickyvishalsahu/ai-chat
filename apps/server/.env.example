# All optional for local dev: anything unset falls back to a local stand-in
# (in-memory Postgres, fake Groq client, no rate limiting). All required
# when NODE_ENV=production.

PORT=3001

# Neon Postgres connection string
DATABASE_URL=

# Upstash Redis (REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Set to "fake" to force the scripted Groq stand-in even when a key is set
CHAT_GROQ_MODE=
